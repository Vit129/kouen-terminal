{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(swift *)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(node Scripts/start.mjs*)",
      "Bash(gh *)",
      "Agent"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Bash(make install*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/skill-trigger.py 2>/dev/null || true",
            "statusMessage": "Skill trigger"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "mcpServers": {
    "kouen": {
      "command": "/Applications/Kouen.app/Contents/MacOS/kouen-mcp",
      "args": [],
      "env": {
        "KOUEN_MCP_ALLOW_CONTROL": "1"
      }
    },
    "graphify": {
      "command": "/Users/supavit.cho/.local/share/uv/tools/graphifyy/bin/graphify-mcp",
      "args": [
        "graphify-out/graph.json",
        "--transport",
        "stdio"
      ]
    }
  }
}